<style id="wp-custom-css">
.pbmit-portfolio-btn,.pbmit-portfolio-title a{display:none}.pbmit-portfolio-style-5 .pbmit-port-cat a{font-size:14px;line-height:20px;letter-spacing:.5px;text-transform:capitalize!important;color:var(--pbmit-xinterio-global-color);pointer-events:none}.pbmit-portfolio-style-5 .pbminfotech-box-content{display:flex;align-items:center;justify-content:space-between;position:absolute;top:inherit;bottom:40px;left:40px;right:40px;padding:10px 15px!important;opacity:0;word-break:break-word;transform:translateY(100%) scale(.7);background:var(--pbmit-xinterio-white-color);transition:.5s}.pbmit-portfolio-style-5 .pbmit-featured-wrapper img{width:100%;transform:scale(1.05) rotate(.5deg);transform-origin:90% 50%;transition:transform 1.2s cubic-bezier(.4, .01, .14, .99);height:450px!important}.pbmit-ihbox-style-22 .pbmit-ihbox-icon-wrapper,.pbmit-ihbox-style-22 .pbmit-ihbox-svg-wrapper{background-color:#e6e6e6!important}.pbmit-service-single-style-1 .pbmit-service-feature-image img{width:100%;margin-bottom:50px;border-radius:30px;display:none!important}.pbmit-heading-subheading .pbmit-heading-desc{margin-top:5px}.pbmit-footer-style-4 .pbmit-base-icon-email{font-size:14px;text-decoration:underline;padding:10px 0 0!important}.pbmit-footer-style-4.pbmit-footer-section .pbmit-footer-text-area,.pbmit-footer-style-4.pbmit-footer-section .pbmit-footer-text-area a{color:#fff}.pbmit-footer-style-4 .pbmit-footer-text-inner{position:relative;overflow:hidden;z-index:1;padding:20px 35px 10px;border-radius:30px 30px 0 0}.pbmit-search-cart-box{display:none;align-items:center;position:relative;padding:0 0 0 30px}.fooer_box_a1 p{margin-bottom:0}.pbmit-footer-widget .widget .widget-title{font-family:Space Grotesk,sans-serif;font-weight:700;font-size:24px;line-height:30px;letter-spacing:-.25px;color:#fff;text-transform:capitalize;font-style:normal}.pbmit-footer-style-4 .pbmit-footer-section.pbmit-footer-widget-area{padding-bottom:40px!important}.pbmit-tbar-subtitle{font-family:Roboto,sans-serif;font-weight:300;font-size:15px;line-height:25px;letter-spacing:.5px;color:#fff;text-transform:capitalize;font-style:normal;display:none}@media (max-width:768px){.pbmit-tbar-title,.single-post .pbmit-title-bar-wrapper .pbmit-tbar .pbmit-tbar-title{font-size:30px;line-height:30px!important;letter-spacing:0}.pbmit-title-bar-content,.pbmit-title-bar-wrapper{min-height:150px}.pbmit-sortable-list-ul li{margin-bottom:7px}.pbmit-sortable-list a{display:inline-block;font-size:14px;padding:8px 15px!important;font-weight:500;min-width:0;border-radius:20px}}.pbmit-header-style-2.site-header .pbmit-logo-area{background-color:var(--pbmit-xinterio-white-color);border-radius:0 0 20px;position:relative;padding:0 2px!important;margin-right:5px}.widget_nav_menu{padding-left:0!important}.pbmit-header-style-2 .pbmit-title-bar-wrapper .pbmit-title-bar-content{padding:50px}.pbmit-title-bar-content .pbmit-tbar-inner{margin-bottom:15px}
